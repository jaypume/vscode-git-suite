{
  "name": "git-suite",
  "displayName": "Git Suite — Like IDEA",
  "description": "JetBrains-like Git management for VS Code — Commit panel, Git Log with graph, multi-repo support and more.",
  "version": "0.10.0",
  "publisher": "pujie",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaypume/vscode-git-suite.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "scm",
    "commit",
    "log",
    "merge",
    "intellij",
    "phpstorm"
  ],
  "icon": "media/icons/gitsuite.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:**/.git",
    "onStartupFinished",
    "onWebviewPanel:gitsuite.undocked"
  ],
  "main": "./out/host/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "gitsuite/explorer",
        "label": "Git Suite"
      },
      {
        "id": "gitsuite.nav.groupBy",
        "label": "Group By",
        "icon": "$(group-by-ref-type)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitsuite-commit",
          "title": "Git Suite Commit",
          "icon": "media/icons/git-commit.svg"
        },
        {
          "id": "gitsuite-navigator",
          "title": "Git Navigator",
          "icon": "media/icons/git-branch.svg"
        }
      ],
      "panel": [
        {
          "id": "gitsuite-log",
          "title": "Git Suite Log",
          "icon": "media/icons/git-merge.svg"
        }
      ]
    },
    "views": {
      "gitsuite-commit": [
        {
          "type": "webview",
          "id": "gitsuite.commitPanel",
          "name": "Git Suite Commit",
          "retainContextWhenHidden": true
        },
        {
          "id": "gitsuite.commitBadge",
          "name": "",
          "when": "false"
        }
      ],
      "gitsuite-log": [
        {
          "type": "webview",
          "id": "gitsuite.gitLog",
          "name": "Git Log",
          "retainContextWhenHidden": true
        },
        {
          "type": "tree",
          "id": "gitsuite.commitFileTree",
          "name": "Commit Files",
          "visibility": "visible"
        }
      ],
      "gitsuite-navigator": [
        {
          "type": "tree",
          "id": "gitsuite.navigator",
          "name": "Navigator"
        }
      ]
    },
    "commands": [
      {
        "command": "gitsuite.log.openFileDiff",
        "title": "Open Changes",
        "category": "Git Suite",
        "icon": "$(compare-changes)"
      },
      {
        "command": "gitsuite.log.toggleFileViewMode",
        "title": "Toggle Tree/Flat View",
        "category": "Git Suite",
        "icon": "$(list-tree)"
      },
      {
        "command": "gitsuite.nav.refresh",
        "title": "Refresh Navigator",
        "category": "Git Suite",
        "icon": "$(refresh)"
      },
      {
        "command": "gitsuite.nav.filterRepos",
        "title": "Filter Repositories",
        "category": "Git Suite",
        "icon": "$(filter)"
      },
      {
        "command": "gitsuite.nav.groupByByRepo",
        "title": "By Repository",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.nav.groupByByType",
        "title": "By Type",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.nav.groupByFlat",
        "title": "Flat",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.nav.groupByByRepoCurrent",
        "title": "$(check) By Repository",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.nav.groupByByTypeCurrent",
        "title": "$(check) By Type",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.nav.groupByFlatCurrent",
        "title": "$(check) Flat",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.nav.branch.checkout",
        "title": "Checkout",
        "category": "Git Suite",
        "icon": "$(check)"
      },
      {
        "command": "gitsuite.nav.branch.merge",
        "title": "Merge into Current",
        "category": "Git Suite",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitsuite.nav.branch.rebase",
        "title": "Rebase onto",
        "category": "Git Suite",
        "icon": "$(rocket)"
      },
      {
        "command": "gitsuite.nav.branch.delete",
        "title": "Delete Branch",
        "category": "Git Suite",
        "icon": "$(trash)"
      },
      {
        "command": "gitsuite.nav.tag.checkout",
        "title": "Checkout Tag",
        "category": "Git Suite",
        "icon": "$(tag)"
      },
      {
        "command": "gitsuite.nav.stash.pop",
        "title": "Pop Stash",
        "category": "Git Suite",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitsuite.nav.stash.apply",
        "title": "Apply Stash",
        "category": "Git Suite",
        "icon": "$(check)"
      },
      {
        "command": "gitsuite.nav.stash.rename",
        "title": "Rename Stash",
        "category": "Git Suite",
        "icon": "$(edit)"
      },
      {
        "command": "gitsuite.nav.stash.drop",
        "title": "Drop Stash",
        "category": "Git Suite",
        "icon": "$(trash)"
      },
      {
        "command": "gitsuite.nav.stash.openFileDiff",
        "title": "Open Changes",
        "category": "Git Suite",
        "icon": "$(compare-changes)"
      },
      {
        "command": "gitsuite.nav.worktree.openInExplorer",
        "title": "Reveal in Explorer",
        "category": "Git Suite",
        "icon": "$(folder)"
      },
      {
        "command": "gitsuite.nav.worktree.openInNewWindow",
        "title": "Open in New Window",
        "category": "Git Suite",
        "icon": "$(link-external)"
      },
      {
        "command": "gitsuite.nav.worktree.openInOS",
        "title": "Reveal in File Manager",
        "category": "Git Suite",
        "icon": "$(folder-opened)"
      },
      {
        "command": "gitsuite.nav.worktree.addToWorkspace",
        "title": "Add to Workspace",
        "category": "Git Suite",
        "icon": "$(fold-vertical)"
      },
      {
        "command": "gitsuite.nav.worktree.lock",
        "title": "Lock Worktree",
        "category": "Git Suite",
        "icon": "$(lock)"
      },
      {
        "command": "gitsuite.nav.worktree.unlock",
        "title": "Unlock Worktree",
        "category": "Git Suite",
        "icon": "$(key)"
      },
      {
        "command": "gitsuite.nav.worktree.remove",
        "title": "Remove Worktree",
        "category": "Git Suite",
        "icon": "$(trash)"
      },
      {
        "command": "gitsuite.nav.worktree.prune",
        "title": "Prune Worktrees",
        "category": "Git Suite",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitsuite.openLog",
        "title": "Focus Git Log",
        "category": "Git Suite",
        "icon": "$(history)"
      },
      {
        "command": "gitsuite.commit",
        "title": "Commit",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.commitAndPush",
        "title": "Commit & Push",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.pull",
        "title": "Pull",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.push",
        "title": "Push All",
        "category": "Git Suite",
        "icon": "$(repo-push)"
      },
      {
        "command": "gitsuite.fetchAll",
        "title": "Fetch All Remotes",
        "category": "Git Suite",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "gitsuite.syncAll",
        "title": "Sync All (Pull + Push)",
        "category": "Git Suite",
        "icon": "$(sync)"
      },
      {
        "command": "gitsuite.openMergeEditor",
        "title": "Open Merge Editor",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.refreshCommitPanel",
        "title": "Refresh Commit Panel",
        "category": "Git Suite",
        "icon": "$(refresh)"
      },
      {
        "command": "gitsuite.reloadRepositories",
        "title": "Reload Repositories",
        "category": "Git Suite",
        "icon": "$(sync)"
      },
      {
        "command": "gitsuite.showBranchMenu",
        "title": "Branch Menu",
        "category": "Git Suite",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitsuite.updateProject",
        "title": "Pull All (Update Project)",
        "category": "Git Suite",
        "icon": "$(repo-pull)"
      },
      {
        "command": "gitsuite.openSettings",
        "title": "Settings",
        "category": "Git Suite",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gitsuite.resetViewLocations",
        "title": "Reset View Locations",
        "category": "Git Suite",
        "icon": "$(discard)"
      },
      {
        "command": "gitsuite.openGitAnnotations",
        "title": "Open Git Annotations",
        "category": "Git Suite",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitsuite.closeGitAnnotations",
        "title": "Close Git Annotations",
        "category": "Git Suite",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitsuite.navigateToAnnotationCommit",
        "title": "Navigate to Commit",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.manageHiddenRepos",
        "title": "Manage Hidden Repositories",
        "category": "Git Suite",
        "icon": "$(eye-closed)"
      },
      {
        "command": "gitsuite.manageProfiles",
        "title": "Manage Git Profiles",
        "category": "Git Suite",
        "icon": "$(account)"
      },
      {
        "command": "gitsuite.switchProfile",
        "title": "Switch Git Profile",
        "category": "Git Suite",
        "icon": "$(account)"
      },
      {
        "command": "gitsuite.submodule.init",
        "title": "Initialize Submodule",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.submodule.update",
        "title": "Update Submodule",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.submodule.updateRecursive",
        "title": "Update Submodule (Recursive)",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.submodule.deinit",
        "title": "Deinit Submodule",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.submodule.deinitForce",
        "title": "Force Deinit Submodule",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.submodule.openInNewWindow",
        "title": "Open Submodule in New Window",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.selectAiModel",
        "title": "Select AI Model",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.showBranchOptions",
        "title": "Branch Options",
        "category": "Git Suite"
      },
      {
        "command": "gitsuite.undock",
        "title": "Undock",
        "category": "Git Suite",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "gitsuite.showFileHistory",
        "title": "Show File History",
        "category": "Git Suite",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitsuite.log.toggleFileViewMode",
          "when": "view == gitsuite.commitFileTree",
          "group": "navigation@1"
        },
        {
          "command": "gitsuite.fetchAll",
          "when": "view == gitsuite.branches",
          "group": "navigation@1"
        },
        {
          "command": "gitsuite.fetchAll",
          "when": "view == gitsuite.navigator",
          "group": "navigation@1"
        },
        {
          "command": "gitsuite.nav.filterRepos",
          "when": "view == gitsuite.navigator",
          "group": "navigation@2"
        },
        {
          "submenu": "gitsuite.nav.groupBy",
          "when": "view == gitsuite.navigator",
          "group": "navigation@3"
        },
        {
          "command": "gitsuite.nav.refresh",
          "when": "view == gitsuite.navigator",
          "group": "navigation@4"
        },
        {
          "command": "gitsuite.fetchAll",
          "when": "view == gitsuite.commitPanel",
          "group": "navigation@1"
        },
        {
          "command": "gitsuite.updateProject",
          "when": "view == gitsuite.commitPanel",
          "group": "navigation@2"
        },
        {
          "command": "gitsuite.push",
          "when": "view == gitsuite.commitPanel",
          "group": "navigation@3"
        },
        {
          "command": "gitsuite.syncAll",
          "when": "view == gitsuite.commitPanel",
          "group": "navigation@4"
        },
        {
          "command": "gitsuite.showBranchMenu",
          "when": "view == gitsuite.commitPanel",
          "group": "navigation@5"
        },
        {
          "command": "gitsuite.openLog",
          "when": "view == gitsuite.commitPanel",
          "group": "navigation@6"
        },
        {
          "command": "gitsuite.openSettings",
          "when": "view == gitsuite.commitPanel",
          "group": "navigation@7"
        }
      ],
      "gitsuite.nav.groupBy": [
        {
          "command": "gitsuite.nav.groupByByRepo",
          "when": "gitsuite.nav.groupBy != 'byRepo'",
          "group": "1_groupBy@1"
        },
        {
          "command": "gitsuite.nav.groupByByRepoCurrent",
          "when": "gitsuite.nav.groupBy == 'byRepo'",
          "group": "1_groupBy@1"
        },
        {
          "command": "gitsuite.nav.groupByByType",
          "when": "gitsuite.nav.groupBy != 'byType'",
          "group": "1_groupBy@2"
        },
        {
          "command": "gitsuite.nav.groupByByTypeCurrent",
          "when": "gitsuite.nav.groupBy == 'byType'",
          "group": "1_groupBy@2"
        },
        {
          "command": "gitsuite.nav.groupByFlat",
          "when": "gitsuite.nav.groupBy != 'flat'",
          "group": "1_groupBy@3"
        },
        {
          "command": "gitsuite.nav.groupByFlatCurrent",
          "when": "gitsuite.nav.groupBy == 'flat'",
          "group": "1_groupBy@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitsuite.nav.branch.checkout",
          "when": "view == gitsuite.navigator && viewItem =~ /^gitsuite\\.nav\\.branch\\.(local|remote)$/",
          "group": "inline@1"
        },
        {
          "command": "gitsuite.nav.branch.checkout",
          "when": "view == gitsuite.navigator && viewItem =~ /^gitsuite\\.nav\\.branch\\.(local|remote)$/",
          "group": "1_actions@1"
        },
        {
          "command": "gitsuite.nav.branch.merge",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.branch.local",
          "group": "1_actions@2"
        },
        {
          "command": "gitsuite.nav.branch.rebase",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.branch.local",
          "group": "1_actions@3"
        },
        {
          "command": "gitsuite.nav.branch.delete",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.branch.local",
          "group": "1_actions@9"
        },
        {
          "command": "gitsuite.nav.tag.checkout",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.tag",
          "group": "1_actions@1"
        },
        {
          "command": "gitsuite.nav.stash.pop",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.stash",
          "group": "inline@1"
        },
        {
          "command": "gitsuite.nav.stash.apply",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.stash",
          "group": "inline@2"
        },
        {
          "command": "gitsuite.nav.stash.drop",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.stash",
          "group": "inline@3"
        },
        {
          "command": "gitsuite.nav.stash.pop",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.stash",
          "group": "1_actions@1"
        },
        {
          "command": "gitsuite.nav.stash.apply",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.stash",
          "group": "1_actions@2"
        },
        {
          "command": "gitsuite.nav.stash.rename",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.stash",
          "group": "9_misc@1"
        },
        {
          "command": "gitsuite.nav.stash.drop",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.stash",
          "group": "1_actions@9"
        },
        {
          "command": "gitsuite.nav.stash.openFileDiff",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.stashFile",
          "group": "navigation@1"
        },
        {
          "command": "gitsuite.nav.worktree.openInNewWindow",
          "when": "view == gitsuite.navigator && viewItem =~ /gitsuite\\.nav\\.worktree/",
          "group": "inline@1"
        },
        {
          "command": "gitsuite.nav.worktree.remove",
          "when": "view == gitsuite.navigator && viewItem =~ /gitsuite\\.nav\\.worktree/",
          "group": "inline@2"
        },
        {
          "command": "gitsuite.nav.worktree.openInExplorer",
          "when": "view == gitsuite.navigator && viewItem =~ /gitsuite\\.nav\\.worktree/",
          "group": "navigation@1"
        },
        {
          "command": "gitsuite.nav.worktree.openInNewWindow",
          "when": "view == gitsuite.navigator && viewItem =~ /gitsuite\\.nav\\.worktree/",
          "group": "navigation@2"
        },
        {
          "command": "gitsuite.nav.worktree.addToWorkspace",
          "when": "view == gitsuite.navigator && viewItem =~ /gitsuite\\.nav\\.worktree/",
          "group": "navigation@3"
        },
        {
          "command": "gitsuite.nav.worktree.openInOS",
          "when": "view == gitsuite.navigator && viewItem =~ /gitsuite\\.nav\\.worktree/",
          "group": "9_misc@1"
        },
        {
          "command": "gitsuite.nav.worktree.lock",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.worktree",
          "group": "1_actions@2"
        },
        {
          "command": "gitsuite.nav.worktree.unlock",
          "when": "view == gitsuite.navigator && viewItem == gitsuite.nav.worktree.locked",
          "group": "1_actions@2"
        },
        {
          "command": "gitsuite.nav.worktree.remove",
          "when": "view == gitsuite.navigator && viewItem =~ /gitsuite\\.nav\\.worktree/",
          "group": "1_actions@9"
        },
        {
          "command": "gitsuite.nav.worktree.prune",
          "when": "view == gitsuite.navigator && viewItem =~ /gitsuite\\.nav\\.(repo|group\\.worktrees)/",
          "group": "1_actions@9"
        },
        {
          "command": "gitsuite.log.openFileDiff",
          "when": "view == gitsuite.commitFileTree && viewItem == gitsuite.logFile",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "gitsuite.fetchAll",
          "when": "activeWebviewPanelId == gitsuite.undocked",
          "group": "navigation@1"
        },
        {
          "command": "gitsuite.updateProject",
          "when": "activeWebviewPanelId == gitsuite.undocked",
          "group": "navigation@2"
        },
        {
          "command": "gitsuite.push",
          "when": "activeWebviewPanelId == gitsuite.undocked",
          "group": "navigation@3"
        },
        {
          "command": "gitsuite.syncAll",
          "when": "activeWebviewPanelId == gitsuite.undocked",
          "group": "navigation@4"
        },
        {
          "command": "gitsuite.showBranchMenu",
          "when": "activeWebviewPanelId == gitsuite.undocked",
          "group": "navigation@5"
        },
        {
          "command": "gitsuite.openSettings",
          "when": "activeWebviewPanelId == gitsuite.undocked",
          "group": "navigation@6"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "gitsuite.manageHiddenRepos",
          "group": "gitsuite@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitsuite.openLog"
        },
        {
          "command": "gitsuite.showBranchMenu"
        },
        {
          "command": "gitsuite.commit"
        },
        {
          "command": "gitsuite.fetchAll"
        },
        {
          "command": "gitsuite.updateProject"
        },
        {
          "command": "gitsuite.push"
        },
        {
          "command": "gitsuite.syncAll"
        },
        {
          "command": "gitsuite.refreshCommitPanel"
        },
        {
          "command": "gitsuite.reloadRepositories"
        },
        {
          "command": "gitsuite.openMergeEditor"
        },
        {
          "command": "gitsuite.manageHiddenRepos"
        },
        {
          "command": "gitsuite.manageProfiles"
        },
        {
          "command": "gitsuite.switchProfile"
        },
        {
          "command": "gitsuite.selectAiModel"
        },
        {
          "command": "gitsuite.undock"
        },
        {
          "command": "gitsuite.submodule.init"
        },
        {
          "command": "gitsuite.submodule.update"
        },
        {
          "command": "gitsuite.submodule.updateRecursive"
        },
        {
          "command": "gitsuite.submodule.deinit"
        },
        {
          "command": "gitsuite.submodule.deinitForce"
        },
        {
          "command": "gitsuite.submodule.openInNewWindow"
        },
        {
          "command": "gitsuite.worktree.add"
        },
        {
          "command": "gitsuite.worktree.prune"
        },
        {
          "command": "gitsuite.openGitAnnotations",
          "when": "resourceScheme == file && config.gitsuite.gitAnnotations.enabled"
        },
        {
          "command": "gitsuite.closeGitAnnotations",
          "when": "resourceScheme == file && gitsuite.annotationsVisible"
        },
        {
          "command": "gitsuite.navigateToAnnotationCommit",
          "when": "false"
        },
        {
          "command": "gitsuite.showFileHistory",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitsuite.commitAndPush",
          "when": "false"
        },
        {
          "command": "gitsuite.pull",
          "when": "false"
        },
        {
          "command": "gitsuite.openSettings",
          "when": "false"
        },
        {
          "command": "gitsuite.showBranchOptions",
          "when": "false"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "gitsuite.openGitAnnotations",
          "when": "resourceScheme == file && config.gitsuite.gitAnnotations.enabled && !gitsuite.annotationsVisible",
          "group": "gitsuite@1"
        },
        {
          "command": "gitsuite.closeGitAnnotations",
          "when": "resourceScheme == file && gitsuite.annotationsVisible",
          "group": "gitsuite@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitsuite/explorer",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitsuite@1"
        }
      ],
      "gitsuite/explorer": [
        {
          "command": "gitsuite.showFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "gitsuite.showFileHistory",
          "when": "resourceScheme == file",
          "group": "gitsuite@1"
        },
        {
          "command": "gitsuite.openMergeEditor",
          "when": "resourceScheme == file",
          "group": "gitsuite@2"
        },
        {
          "command": "gitsuite.openGitAnnotations",
          "when": "resourceScheme == file && config.gitsuite.gitAnnotations.enabled && !gitsuite.annotationsVisible",
          "group": "gitsuite@3"
        },
        {
          "command": "gitsuite.closeGitAnnotations",
          "when": "resourceScheme == file && gitsuite.annotationsVisible",
          "group": "gitsuite@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitsuite.openLog",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "gitsuite.commit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "colors": [
      {
        "id": "gitsuite.statusBarPullForeground",
        "description": "Status bar text color when incoming commits are available (pull needed)",
        "defaults": {
          "dark": "#64b5f6",
          "light": "#1565c0",
          "highContrast": "#64b5f6",
          "highContrastLight": "#1565c0"
        }
      },
      {
        "id": "gitsuite.statusBarPushForeground",
        "description": "Status bar text color when there are unpushed commits or the branch is not on remote",
        "defaults": {
          "dark": "#ce93d8",
          "light": "#6a1b9a",
          "highContrast": "#ce93d8",
          "highContrastLight": "#6a1b9a"
        }
      },
      {
        "id": "gitsuite.statusBarDirtyForeground",
        "description": "Status bar text color when there are uncommitted changes",
        "defaults": {
          "dark": "#81c784",
          "light": "#2e7d32",
          "highContrast": "#81c784",
          "highContrastLight": "#2e7d32"
        }
      }
    ],
    "configuration": [
      {
        "title": "Basic Settings",
        "properties": {
          "gitsuite.graphMaxCommits": {
            "order": 80,
            "type": "number",
            "default": 1000,
            "minimum": 100,
            "maximum": 10000,
            "description": "Maximum commits to load in the Git Log graph"
          },
          "gitsuite.repositoryScanMaxDepth": {
            "order": 60,
            "type": "number",
            "default": 1,
            "minimum": 0,
            "maximum": 10,
            "description": "Maximum depth of workspace subfolders to scan for Git repositories (0 = only workspace folders)."
          },
          "gitsuite.repositoryScanIgnoredFolders": {
            "order": 70,
            "type": "array",
            "default": [
              "node_modules"
            ],
            "items": {
              "type": "string"
            },
            "description": "Folder names or workspace-relative paths to skip while scanning for nested Git repositories."
          },
          "gitsuite.fetchOnStartup": {
            "order": 40,
            "type": "boolean",
            "default": true,
            "description": "Automatically fetch all remotes when the extension activates"
          },
          "gitsuite.notifyOnIncomingCommits": {
            "order": 50,
            "type": "boolean",
            "default": true,
            "description": "Show a notification on startup when there are incoming commits available to pull"
          },
          "gitsuite.notifyOnUnpushedCommits": {
            "order": 55,
            "type": "boolean",
            "default": true,
            "description": "Show a notification on startup when there are unpushed commits ready to push"
          },
          "gitsuite.projectColors": {
            "order": 110,
            "type": "object",
            "default": {},
            "description": "Map of workspace folder/repository name to hex color for the commit graph (e.g. {\"my-repo\": \"#ff6b6b\"})"
          },
          "gitsuite.autoRefreshInterval": {
            "order": 30,
            "type": "number",
            "default": 0,
            "minimum": 0,
            "description": "Auto-refresh interval in seconds (0 = disabled, use file watchers only)"
          },
          "gitsuite.gitAnnotations.enabled": {
            "order": 90,
            "type": "boolean",
            "default": true,
            "description": "Enable Git Annotations in the editor."
          },
          "gitsuite.gitGhostText.enabled": {
            "order": 100,
            "type": "boolean",
            "default": true,
            "description": "Enable inline Git ghost text in the editor."
          },
          "gitsuite.changesViewMode": {
            "order": 10,
            "type": "string",
            "enum": [
              "simplified",
              "changelists",
              "vscode"
            ],
            "enumDescriptions": [
              "Show Staged and Unstaged sections per repository (default behavior)",
              "Show files grouped by Changelists, similar to PhpStorm",
              "Show Staged Changes / Changes sections like native VS Code, with inline stage/unstage buttons"
            ],
            "default": "simplified",
            "description": "How to display changed files in the Changes tab."
          },
          "gitsuite.promptAddUntrackedToGit": {
            "order": 25,
            "type": "boolean",
            "default": true,
            "description": "Show a prompt when new untracked files are detected, offering to add them to Git."
          },
          "gitsuite.defaultCommitAction": {
            "order": 20,
            "type": "string",
            "enum": [
              "commit",
              "commitAndPush"
            ],
            "enumDescriptions": [
              "The main button commits without pushing",
              "The main button commits and pushes immediately"
            ],
            "default": "commit",
            "description": "Default action for the commit button in the Commit Panel."
          },
          "gitsuite.defaultSaveAction": {
            "order": 21,
            "type": "string",
            "enum": [
              "stash",
              "shelve"
            ],
            "enumDescriptions": [
              "The main Save button stashes selected changes",
              "The main Save button shelves selected changes"
            ],
            "default": "stash",
            "description": "Default action for the Save button in the Commit Panel."
          },
          "gitsuite.suppressDivergedBranchWarning": {
            "order": 35,
            "type": "boolean",
            "default": false,
            "description": "Suppress the 'Branches have diverged' warning in the Git Menu and status bar."
          }
        }
      },
      {
        "title": "AI Settings",
        "properties": {
          "gitsuite.ai.enabled": {
            "order": 0,
            "type": "boolean",
            "default": true,
            "description": "Enable AI features in Git Suite (commit message generation, commit explanation). When disabled, all AI actions are hidden."
          },
          "gitsuite.ai.language": {
            "order": 1,
            "type": "string",
            "default": "",
            "markdownDescription": "Language for AI-generated text (e.g. `en`, `it`, `fr`, `de`). Leave empty to use the VS Code display language."
          },
          "gitsuite.ai.provider": {
            "order": 2,
            "type": "string",
            "enum": [
              "vscode-lm",
              "claude-api",
              "openai-api",
              "gemini-api",
              "claude-cli",
              "codex-cli",
              "gemini-cli",
              "ollama",
              "lmstudio"
            ],
            "enumDescriptions": [
              "Use VS Code Language Model API (GitHub Copilot or any registered LM extension)",
              "Use Anthropic API directly (requires API key)",
              "Use OpenAI API directly (requires API key)",
              "Use Google Gemini API directly (requires API key)",
              "Use Claude CLI (claude --print)",
              "Use Codex CLI (codex exec)",
              "Use Gemini CLI (gemini -p)",
              "Use a local Ollama model via HTTP API",
              "Use a local LM Studio model via HTTP API"
            ],
            "default": "vscode-lm",
            "description": "AI provider to use for all AI features."
          },
          "gitsuite.ai.modelId": {
            "order": 2,
            "type": "string",
            "default": "",
            "description": "VS Code LM model ID (e.g. 'copilot:gpt-4o'). Only used when provider is 'vscode-lm'. Leave empty to auto-select. Use the 'Git Suite: Select AI Model' command to pick interactively."
          },
          "gitsuite.ai.claudeApiKey": {
            "order": 3,
            "type": "string",
            "default": "",
            "description": "Anthropic API key. Only used when provider is 'claude-api'. Get your key at console.anthropic.com."
          },
          "gitsuite.ai.claudeModel": {
            "order": 4,
            "type": "string",
            "default": "",
            "description": "Claude model ID (e.g. 'claude-opus-4-7', 'claude-sonnet-4-6'). Used when provider is 'claude-api' or 'claude-cli'. Leave empty to use the default. Use the 'Git Suite: Select AI Model' command to pick interactively."
          },
          "gitsuite.ai.claudePath": {
            "order": 5,
            "type": "string",
            "default": "claude",
            "description": "Path to the Claude CLI binary. Only used when provider is 'claude-cli'. Defaults to 'claude' (must be on PATH)."
          },
          "gitsuite.ai.openaiApiKey": {
            "order": 6,
            "type": "string",
            "default": "",
            "description": "OpenAI API key. Only used when provider is 'openai-api'. Get your key at platform.openai.com."
          },
          "gitsuite.ai.openaiModel": {
            "order": 7,
            "type": "string",
            "default": "gpt-4o",
            "description": "OpenAI model ID (e.g. 'gpt-4o', 'gpt-4o-mini', 'o3'). Only used when provider is 'openai-api'."
          },
          "gitsuite.ai.geminiApiKey": {
            "order": 8,
            "type": "string",
            "default": "",
            "description": "Google Gemini API key. Only used when provider is 'gemini-api'. Get your key at aistudio.google.com."
          },
          "gitsuite.ai.geminiModel": {
            "order": 9,
            "type": "string",
            "default": "gemini-2.0-flash",
            "description": "Gemini model ID (e.g. 'gemini-2.0-flash', 'gemini-2.5-pro'). Used when provider is 'gemini-api' or 'gemini-cli'."
          },
          "gitsuite.ai.geminiPath": {
            "order": 10,
            "type": "string",
            "default": "gemini",
            "description": "Path to the Gemini CLI binary. Only used when provider is 'gemini-cli'. Defaults to 'gemini' (must be on PATH)."
          },
          "gitsuite.ai.codexModel": {
            "order": 11,
            "type": "string",
            "default": "",
            "description": "Codex model ID to use (e.g. 'o3', 'o4-mini'). Only used when provider is 'codex-cli'. Leave empty to use the CLI default. Use the 'Git Suite: Select AI Model' command to pick interactively."
          },
          "gitsuite.ai.codexPath": {
            "order": 9,
            "type": "string",
            "default": "codex",
            "description": "Path to the Codex CLI binary. Only used when provider is 'codex-cli'. Defaults to 'codex' (must be on PATH)."
          },
          "gitsuite.ai.lmStudioModel": {
            "order": 7,
            "type": "string",
            "default": "",
            "description": "LM Studio model identifier. Only used when provider is 'lmstudio'. Leave empty to use the currently loaded model. Use the 'Git Suite: Select AI Model' command to pick interactively."
          },
          "gitsuite.ai.lmStudioUrl": {
            "order": 8,
            "type": "string",
            "default": "http://localhost:1234",
            "description": "Base URL of the LM Studio local server. Only used when provider is 'lmstudio'."
          },
          "gitsuite.ai.ollamaModel": {
            "order": 11,
            "type": "string",
            "default": "llama3",
            "description": "Ollama model name (e.g. 'llama3', 'mistral', 'qwen3.5:9b'). Only used when provider is 'ollama'."
          },
          "gitsuite.ai.ollamaUrl": {
            "order": 12,
            "type": "string",
            "default": "http://localhost:11434",
            "description": "Base URL of the Ollama API. Only used when provider is 'ollama'."
          },
          "gitsuite.ai.maxDiffChars": {
            "order": 13,
            "type": "number",
            "default": 8000,
            "minimum": 1000,
            "maximum": 100000,
            "description": "Maximum characters of git diff to send to the AI model. Larger values give more context but consume more tokens."
          }
        }
      },
      {
        "title": "Experimental",
        "properties": {
          "gitsuite.resetViewLocationsOnStartup": {
            "order": 1,
            "type": "boolean",
            "default": false,
            "description": "Run VS Code's 'Reset View Locations' action on startup. Useful to clear stale Git Suite badge placement, but it resets view positions globally."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:host && npm run build:webview",
    "build:host": "node esbuild.mjs --prod",
    "build:webview": "node build-webview.mjs",
    "watch": "concurrently \"npm run watch:host\" \"npm run watch:webview\"",
    "watch:host": "node esbuild.mjs --watch",
    "watch:webview": "node build-webview.mjs --watch",
    "package": "vsce package",
    "publish": "vsce publish",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:webview": "tsc --noEmit -p tsconfig.webview.json"
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-virtual": "^3.2.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^2.24.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.56.0",
    "material-icon-theme": "^5.34.0",
    "monaco-editor": "^0.47.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.0.0",
    "zustand": "^4.5.0"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.20.0",
    "@esbuild/linux-arm64": "^0.20.0",
    "@rollup/rollup-darwin-arm64": "^4.60.4"
  }
}
